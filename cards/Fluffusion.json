      "cases": [
        { "ids": "01-05", "value": "Quando vou ao backstage: Posso revelar e trazer à mão um Adulto ${name} do seu deck.\n(1-HP) Vire-me: aplico 2 ${element}.\n(3-En) União ${main_archetype} [Mão/Campo]: Envie a mim e  um Adulto ${name} do seu campo ao backstage para invocar a Família ${name} do seu deck no lugar dele. Ao invocá-la, posso revelar e trazer à mão um Filhote ${main_archetype} do seu deck." },
        { "ids": "06-10", "value": "Passivo: Meu efeito de cura não custa vida se o alvo for um Filhote ${name} adjacente a mim.\n(1-HP) Vire-me: Curo um Filhote ${main_archetype} do seu campo em 1 de vida, até sua vida máxima.\n(1-En) Quando invocado: Posso revelar e trazer à mão um Filhote ${name} do seu deck ou do backstage.\n(2-En) Vire-me: Aplico 2 ${element}." },
        { "ids": "11-15", "value": "Passivo: Invocada apenas por União ${main_archetype}. Ao sair da posse do meu dono, volto ao deck dele. Cada jogador pode invocar até 1 Família por turno.\n(1-En) Vire-me: Aplico 2 ${element}.\nEmbaralhe-me no deck [Mão] ou (1-En) Vire-me: ${effect_${element}}" }
      ]
    },
    "effect_cryo": "Se um ${main_archetype} aliado inativo tiver cryo pendente, posso remover esse token para curá-lo em 2 de vida.",
    "effect_electro": "Se um ${main_archetype} aliado inativo tiver electro pendente e puder ser reativado, posso remover esse token para ativá-lo e deixá-lo exausto.",
    "effect_anemo": "Posso mover uma unidade para um espaço adjacente vazio. Pago 1 energia extra se for adversária e 1 se houver Ruptura no destino.",
    "effect_caelo": "Se houver no backstage um Filhote e um Adulto ${main_archetype} do mesmo elemento, posso devolver ambos ao seu deck.",
    "effect_abysso": "Se houver no backstage um Adulto ${main_archetype} do mesmo elemento de um Filhote na sua mão, posso descartar o Filhote e recuperar o Adulto."
